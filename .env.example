# Local (non-Docker) API. Copy to server/.env.
# Docker does not use this file. Compose loads docker/backend.env.

NODE_ENV=development
HOST=0.0.0.0
PORT=3000

# Use 5432 for a Postgres installed on the host.
# Use 5433 if Postgres is the docker-compose service (published only on localhost).
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/blakbox_dev

# Required by config even when STORAGE_DRIVER=memory (tests and local UI without MinIO).
MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_ACCESS_KEY=local-dev
MINIO_SECRET_KEY=local-dev
MINIO_BUCKET=blakbox
MINIO_REGION=us-east-1
STORAGE_DRIVER=memory
TRUST_PROXY=false
COOKIE_SECURE=false
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://[::1]:5173,http://127.0.0.1:8080,http://localhost:8080,http://[::1]:8080
