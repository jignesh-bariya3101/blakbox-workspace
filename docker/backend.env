# Loaded by docker-compose for the API container.
# Demo values only. Change them before any real deployment.

NODE_ENV=production
HOST=0.0.0.0
PORT=3000

# Host name `postgres` is the Compose service. Do not use localhost here.
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/blakbox_dev

# Host name `minio` is the Compose service.
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=blakbox
MINIO_REGION=us-east-1
STORAGE_DRIVER=s3

# Browser talks to the API on port 3000. Do not trust client-sent X-Real-IP.
TRUST_PROXY=false

# Compose UI is HTTP. Set true only behind HTTPS.
COOKIE_SECURE=false

# Page origins allowed to call the API with cookies.
CORS_ORIGINS=http://127.0.0.1:8080,http://localhost:8080,http://[::1]:8080,http://127.0.0.1:5173,http://localhost:5173,http://[::1]:5173
