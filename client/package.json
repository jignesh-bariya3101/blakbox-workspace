    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@playwright/test": "^1.55.0",
    "@vitejs/plugin-react": "^5.0.2",
    "eslint": "^9.36.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.44.1",
    "vite": "^7.1.5",
